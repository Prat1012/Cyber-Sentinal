# ============================================================
# CyberSentinel environment configuration
# Copy this file to `.env` and adjust values for your environment.
# Never commit the real `.env` file to version control.
# ============================================================

# Application
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- SECURITY: change this to a long random string in production ---
SECRET_KEY=change-me-to-a-long-random-string

# Authentication
AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt cost factor (12 recommended for production)
BCRYPT_ROUNDS=12

# Database (SQLite default; PostgreSQL example below)
DATABASE_URL=sqlite:///./cybersentinel.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cybersentinel
AUTO_CREATE_TABLES=true

# CORS - comma separated list of allowed origins ("*" allows all)
CORS_ORIGINS=*

# Paths (relative to the backend/ directory)
REPORTS_DIR=../reports
FRONTEND_DIR=../frontend

# Scan engine
SCAN_MAX_CONCURRENT=2
SCAN_TIMEOUT_SECONDS=300
# Path to the nmap binary; leave as "nmap" to use PATH lookup
NMAP_BIN_PATH=nmap

# Target safety policy
# When false, only loopback and RFC1918 private addresses (and "localhost")
# may be scanned. Set to true ONLY for authorized external assessments.
ALLOW_EXTERNAL_TARGETS=false
# Optional comma-separated allowlist of IPs/CIDRs/hostnames. When set, only
# these targets may be scanned.
ALLOWED_TARGETS=

# Web scanner limits
WEB_CONNECT_TIMEOUT=5.0
WEB_READ_TIMEOUT=10.0
WEB_MAX_RESPONSE_BYTES=2000000

# Directory discovery limits (controlled, rate-limited)
DIRECTORY_WORDLIST=admin,api,backup,.git/config,config,console,debug,dev,docs,jenkins,login,phpmyadmin,private,robots.txt,server-status,test,uploads,wp-admin
DIRECTORY_MAX_PATHS=30
DIRECTORY_DELAY_SECONDS=0.2

# API rate limiting (per client IP)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
